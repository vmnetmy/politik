{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nadirakyat.my/schemas/seating.schema.json",
  "title": "Dewan Rakyat seating artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sourceFile", "sourceUpdatedAt", "viewBox", "mappedSeatCount", "unmappedSeatCodes", "positions"],
  "properties": {
    "version": { "const": 1 },
    "sourceFile": { "type": "string", "minLength": 1 },
    "sourceUpdatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "viewBox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "mappedSeatCount": { "type": "integer", "minimum": 0, "maximum": 222 },
    "unmappedSeatCodes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^P\\.\\d{3}$" }
    },
    "positions": {
      "type": "array",
      "maxItems": 222,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["seatCode", "sourceConstituency", "x", "y"],
        "properties": {
          "seatCode": { "type": "string", "pattern": "^P\\.\\d{3}$" },
          "sourceConstituency": { "type": "string", "minLength": 1 },
          "x": { "type": "number", "minimum": 0 },
          "y": { "type": "number", "minimum": 0 }
        }
      }
    }
  }
}
