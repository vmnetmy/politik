{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://politik.my/schemas/seating.schema.json",
  "title": "Dewan Rakyat seating artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sourceFile", "sourceSha256", "sourceUpdatedAt", "viewBox", "layout", "mappedSeatCount", "unmappedSeatCodes", "positions", "emptyPositions"],
  "properties": {
    "version": { "const": 4 },
    "sourceFile": { "type": "string", "minLength": 1 },
    "sourceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceUpdatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "viewBox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "geometryFile", "geometrySha256", "rasterFile", "rasterSha256", "physicalSeatCount"],
      "properties": {
        "strategy": { "const": "svg-source-rect-v3" },
        "geometryFile": { "const": "SeatingDR.svg" },
        "geometrySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "rasterFile": { "const": "SeatingDR-1.png" },
        "rasterSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "physicalSeatCount": { "const": 280 }
      }
    },
    "mappedSeatCount": { "type": "integer", "minimum": 0, "maximum": 222 },
    "unmappedSeatCodes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^P\\.\\d{3}$" }
    },
    "positions": {
      "type": "array",
      "maxItems": 222,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["seatCode", "physicalCode", "sourceConstituency", "sourceX", "sourceY", "x", "y", "section"],
        "properties": {
          "seatCode": { "type": "string", "pattern": "^P\\.\\d{3}$" },
          "physicalCode": { "type": "string", "pattern": "^[A-G](?:[1-9]|[1-5][0-9]|60)$" },
          "sourceConstituency": { "type": "string", "minLength": 1 },
          "sourceX": { "type": "number", "minimum": 0, "maximum": 1190 },
          "sourceY": { "type": "number", "minimum": 0, "maximum": 842 },
          "x": { "type": "number", "minimum": 0, "maximum": 1190 },
          "y": { "type": "number", "minimum": 0, "maximum": 842 },
          "section": { "enum": ["straight-left", "straight-right", "curved"] }
        }
      }
    },
    "emptyPositions": {
      "type": "array",
      "minItems": 60,
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "physicalCode", "sourceX", "sourceY", "x", "y", "section"],
        "properties": {
          "id": { "type": "string", "pattern": "^EMPTY-[A-G](?:[1-9]|[1-5][0-9]|60)$" },
          "physicalCode": { "type": "string", "pattern": "^[A-G](?:[1-9]|[1-5][0-9]|60)$" },
          "sourceX": { "type": "number", "minimum": 0, "maximum": 1190 },
          "sourceY": { "type": "number", "minimum": 0, "maximum": 842 },
          "x": { "type": "number", "minimum": 0, "maximum": 1190 },
          "y": { "type": "number", "minimum": 0, "maximum": 842 },
          "section": { "enum": ["straight-left", "straight-right", "curved"] }
        }
      }
    }
  }
}
