{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://politik.my/schemas/election-registry.schema.json",
  "title": "Election edition registry",
  "type": "object",
  "required": ["version", "defaultElectionId", "elections"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "defaultElectionId": { "type": "string", "pattern": "^pru-[0-9]+$" },
    "elections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "number", "shortTitle", "electionDate", "termId", "boundaryVersion", "isCurrentTerm", "path", "capabilities"],
        "properties": {
          "id": { "type": "string", "pattern": "^pru-[0-9]+$" },
          "number": { "type": "integer", "minimum": 1 },
          "shortTitle": { "type": "string", "minLength": 1 },
          "electionDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "termId": { "type": "string", "pattern": "^dr-[0-9]+$" },
          "boundaryVersion": { "type": "string", "minLength": 1 },
          "isCurrentTerm": { "type": "boolean" },
          "path": { "type": "string", "pattern": "^elections/pru-[0-9]+$" },
          "capabilities": {
            "type": "object",
            "required": ["seating", "scoresheets", "voterRoll", "voterAge", "voterEthnicity", "geography"],
            "additionalProperties": false,
            "properties": {
              "seating": { "type": "boolean" },
              "scoresheets": { "type": "boolean" },
              "voterRoll": { "type": "boolean" },
              "voterAge": { "type": "boolean" },
              "voterEthnicity": { "type": "boolean" },
              "geography": { "type": "boolean" }
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
