{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://politik.my/schemas/election.schema.json",
  "title": "Namespaced parliamentary election result",
  "type": "object",
  "required": ["metadata", "alliances", "seats"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["electionId", "electionNumber", "termId", "boundaryVersion", "title", "shortTitle", "electionDate", "seatCount", "candidateCount"],
      "properties": {
        "electionId": { "type": "string", "pattern": "^pru-[0-9]+$" },
        "electionNumber": { "type": "integer", "minimum": 1 },
        "termId": { "type": "string", "pattern": "^dr-[0-9]+$" },
        "boundaryVersion": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "shortTitle": { "type": "string", "minLength": 1 },
        "electionDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "seatCount": { "type": "integer", "minimum": 1 },
        "candidateCount": { "type": "integer", "minimum": 1 }
      }
    },
    "alliances": { "type": "array" },
    "seats": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["electionId", "contestId", "code", "state", "name", "winner", "candidates"],
        "properties": {
          "electionId": { "type": "string", "pattern": "^pru-[0-9]+$" },
          "contestId": { "type": "string", "pattern": "^pru-[0-9]+:P\\.[0-9]{3}$" },
          "code": { "type": "string", "pattern": "^P\\.[0-9]{3}$" },
          "state": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "validVotes": { "type": "integer", "minimum": 0 },
          "rejectedVotes": { "type": "integer", "minimum": 0 },
          "unreturnedVotes": { "type": "integer", "minimum": 0 },
          "winner": { "$ref": "#/definitions/candidate" },
          "candidates": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/candidate" } }
        }
      }
    }
  },
  "definitions": {
    "candidate": {
      "type": "object",
      "required": ["id", "electionId", "candidacyId", "personId", "name", "alliance", "party", "votes", "share"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "electionId": { "type": "string", "pattern": "^pru-[0-9]+$" },
        "candidacyId": { "type": "string", "pattern": "^pru-[0-9]+:P\\.[0-9]{3}:[0-9]{2}$" },
        "personId": { "type": "string", "pattern": "^person:" },
        "name": { "type": "string", "minLength": 1 },
        "alliance": { "type": "string", "minLength": 1 },
        "party": { "type": "string", "minLength": 1 },
        "votes": { "type": "integer", "minimum": 0 },
        "share": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
