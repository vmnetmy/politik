{
  "name": "politik-election-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint src api server scripts/*.mjs vite.config.ts vitest.config.ts playwright.config.ts --deny-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:python": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:e2e": "playwright test",
    "test:visual": "node scripts/compare_visuals.mjs",
    "lighthouse": "node scripts/run_lighthouse.mjs",
    "staging:check": "npm run build && node scripts/verify_staging.mjs",
    "db:migrate": "node scripts/migrate_database.mjs",
    "db:seed": "node scripts/seed_database.mjs",
    "data:reconcile": "python3 scripts/reconcile_election_data.py",
    "data:reconcile:check": "python3 scripts/reconcile_election_data.py --check",
    "data:reconcile:publish": "node scripts/publish_reconciliation.mjs",
    "data:seating": "python3 scripts/extract_seating.py",
    "data:seating:check": "python3 scripts/extract_seating.py --check",
    "data:voter-age": "python3 scripts/extract_voter_age.py",
    "data:voter-age:check": "python3 scripts/extract_voter_age.py --check",
    "data:voter-roll": "python3 scripts/extract_voter_roll.py",
    "data:voter-roll:check": "python3 scripts/extract_voter_roll.py --check",
    "data:scoresheets": "python3 scripts/build_scoresheet_data.py",
    "data:scoresheets:check": "python3 scripts/build_scoresheet_data.py --check",
    "data:spr-pru15": "python3 scripts/audit_spr_pru15.py --refresh",
    "data:spr-pru15:check": "python3 scripts/audit_spr_pru15.py --check",
    "data:geography": "python3 scripts/extract_geography.py",
    "data:geography:check": "python3 scripts/extract_geography.py --check",
    "data:boundaries": "python3 scripts/extract_election_boundaries.py --refresh",
    "data:boundaries:check": "python3 scripts/extract_election_boundaries.py --check",
    "data:atlas": "python3 scripts/extract_atlas_boundaries.py",
    "data:atlas:check": "python3 scripts/extract_atlas_boundaries.py --check",
    "data:state-elections:gazette": "python3 scripts/extract_johor_gazette.py",
    "data:state-elections:gazette:check": "python3 scripts/extract_johor_gazette.py --check",
    "data:state-elections": "python3 scripts/extract_johor_gazette.py && python3 scripts/extract_state_elections.py",
    "data:state-elections:check": "python3 scripts/extract_johor_gazette.py --check && python3 scripts/extract_state_elections.py --check",
    "data:state-elections:fetch-johor": "python3 scripts/fetch_myspr_state_results.py",
    "data:federal-elections": "python3 scripts/extract_federal_election.py --election-number 14",
    "data:federal-elections:check": "python3 scripts/extract_federal_election.py --election-number 14 --check",
    "data:manifest": "python3 scripts/build_data_manifest.py --all",
    "data:manifest:check": "python3 scripts/build_data_manifest.py --all --check",
    "data:persons": "python3 scripts/build_person_registry.py",
    "data:persons:check": "python3 scripts/build_person_registry.py --check"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "chart.js": "^4.5.1",
    "d3-geo": "^3.1.1",
    "motion": "^12.42.2",
    "postgres": "^3.4.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "7.18.1",
    "web-vitals": "^5.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-geo": "^3.1.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "ajv": "^8.20.0",
    "axe-core": "^4.12.1",
    "jsdom": "^27.0.1",
    "lighthouse": "^13.4.1",
    "oxlint": "^1.75.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "^3.2.7"
  }
}
